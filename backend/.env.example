# Copy this file to backend/.env and fill in your own values.
# The original .env was intentionally NOT published. Use your own Anthropic API key.

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional settings (defaults shown)
FLASK_PORT=5000
UPLOAD_FOLDER=uploads
LOG_FOLDER=logs
MAX_IMAGE_SIZE_MB=10
